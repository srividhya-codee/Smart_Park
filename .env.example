# GEMINI_API_KEY: Required for ParkMate AI Natural Language understanding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL connection string for production deployments
DATABASE_URL="postgresql://postgres:smartpark_secure_pwd@localhost:5432/smartpark_chennai"

# Redis connection string for distributed mutex locking
REDIS_URL="redis://localhost:6379"

# GCC Smart Parking Node Environment
NODE_ENV="development"
